{
  "name": "pycodex",
  "displayName": "Pycodex",
  "description": "Workspace chat using your Python environment and Codex profiles, with inline code context and context usage.",
  "version": "0.0.1",
  "publisher": "randomizez",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Randomizez/pycodex.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/Randomizez/pycodex",
  "bugs": {
    "url": "https://github.com/Randomizez/pycodex/issues"
  },
  "icon": "media/pycodex.png",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "categories": ["AI", "Other"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pycodex sessions can execute tools and edit workspace files."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The Python backend needs access to the workspace filesystem."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "pycodex", "title": "Pycodex", "icon": "media/pycodex.svg" }
      ]
    },
    "views": {
      "pycodex": [
        { "type": "webview", "id": "pycodex.chat", "name": "Pycodex" }
      ]
    },
    "configuration": {
      "title": "Pycodex",
      "properties": {
        "pycodex.profile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Profile in the workspace host's ~/.codex/config.toml, for example step uses [profiles.step]. Leave empty to use the default configuration. Remote workspaces use the remote host's config. The chat settings button edits this value. Reload the window to apply changes to a running backend."
        },
        "pycodex.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python interpreter used to install and run Pycodex, for example .venv/bin/python or .venv\\Scripts\\python.exe. Select an environment from the chat settings button. Leave empty to reuse an existing Pycodex installation or Python on PATH. Remote workspaces use the remote host's interpreter. Reload the window to apply changes to a running backend."
        }
      }
    },
    "commands": [
      {
        "command": "pycodex.insertContext",
        "title": "Pycodex: Insert Code Context"
      },
      {
        "command": "pycodex.newSession",
        "title": "Pycodex: New Session"
      }
    ],
    "keybindings": [
      {
        "command": "pycodex.insertContext",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pycodex.insertContext",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "pycodex.insertContext",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@100"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "pycodex.insertContext",
          "group": "navigation@100"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node scripts/build.cjs",
    "watch": "npm run compile && tsc -watch -p .",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.6.2",
    "markdown-it": "14.1.0",
    "typescript": "~5.9.3"
  }
}
